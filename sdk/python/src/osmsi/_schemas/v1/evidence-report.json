{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmsi.disobedientgeometry.com/schemas/v1/evidence-report.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "dimension", "sample", "model", "created_at", "methodology", "metrics", "provenance", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"$ref": "common.json#/$defs/run_id"},
    "dimension": {"enum": ["hc", "in"]},
    "sample": {"type": "boolean"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "methodology": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "description", "references"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "references": {"type": "array", "items": {"type": "string", "format": "uri"}, "minItems": 1}
      }
    },
    "metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "value", "unit", "direction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "direction": {"enum": ["descriptive", "higher_more_capable", "higher_more_recovery"]},
          "n": {"type": "integer", "minimum": 0},
          "interval": {
            "type": "object", "additionalProperties": false, "required": ["low", "high", "level", "method"],
            "properties": {
              "low": {"type": "number"}, "high": {"type": "number"},
              "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
              "method": {"type": "string", "minLength": 1}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "provenance": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
